# publish-bridge v0.3 · 单用户本地自用
# 复制为 publish-bridge/.env 仅供参考；服务不自动加载 .env，请用环境变量或 shell 传入。
# 示例：HOST=0.0.0.0 API_TOKEN='一串随机值' DRY_RUN=1 node src/server.js

# --- 网络（默认只监听 127.0.0.1）---
HOST=127.0.0.1
PORT=8787
# 不设置则自动生成并写入 data/config.json；手机端连接时务必自己设一个强随机值
API_TOKEN=
# 仅在完全可信的单机环境可关掉鉴权
AUTH_REQUIRED=true

# --- 浏览器 ---
BROWSER_CHANNEL=chrome
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
HEADLESS=false

# --- 发布行为 ---
# 默认 true：点「一键发布」后由 Playwright 填表并点击平台发布按钮
# 设为 false 则只填表，发布页留给你本人手动点
AUTO_CLICK_PUBLISH=true
# 演示/自测：不启动浏览器、不访问任何平台
DRY_RUN=false

# --- 差异化改写 ---
REWRITE_MODE=rule
# REWRITE_MODE=llm 时可接本地 vLLM / OpenAI 兼容端点
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
SIMILARITY_THRESHOLD=0.82
